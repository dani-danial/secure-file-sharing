PORT=4000

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase service_role key. Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Name of the private storage bucket that holds uploaded files.
SUPABASE_BUCKET=uploads

# Allowed origin for the React frontend during development.
CORS_ORIGIN=http://localhost:5173

# Per-file upload cap in bytes (default 50 MB).
MAX_FILE_BYTES=52428800

# Default share-link expiry in days if the client does not pass one.
DEFAULT_EXPIRY_DAYS=7

# Hard cap on requested expiry in days.
MAX_EXPIRY_DAYS=30

# How long a signed download URL stays valid, in seconds.
SIGNED_URL_TTL_SECONDS=60

# Public base URL of the frontend used to build shareable links.
PUBLIC_SHARE_BASE_URL=http://localhost:5173/s
